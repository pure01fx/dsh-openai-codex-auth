{
  "name": "@pure01fx/dsh-openai-codex-auth",
  "version": "0.11.2",
  "description": "Native ChatGPT Codex provider, device-code-first login, and same-origin Web integration for DeepSeek Harness",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pure01fx/dsh-openai-codex-auth.git"
  },
  "homepage": "https://github.com/pure01fx/dsh-openai-codex-auth#readme",
  "bugs": "https://github.com/pure01fx/dsh-openai-codex-auth/issues",
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "openai",
    "codex",
    "oauth"
  ],
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/index.d.ts",
    "lib/catalog.js",
    "lib/catalog.d.ts",
    "lib/endpoint.js",
    "lib/endpoint.d.ts",
    "lib/native-adapter.js",
    "lib/native-adapter.d.ts",
    "lib/native-http.js",
    "lib/native-http.d.ts",
    "lib/network-telemetry.js",
    "lib/network-telemetry.d.ts",
    "lib/native-websocket.js",
    "lib/native-websocket.d.ts",
    "lib/native-websocket-session.js",
    "lib/native-websocket-session.d.ts",
    "lib/native-websocket-socket.js",
    "lib/native-websocket-socket.d.ts",
    "lib/responses.js",
    "lib/responses.d.ts",
    "lib/replay.js",
    "lib/replay.d.ts",
    "lib/retry-after.js",
    "lib/retry-after.d.ts",
    "lib/rate-limits.js",
    "lib/rate-limits.d.ts",
    "lib/response-usage.js",
    "lib/response-usage.d.ts",
    "lib/upstream.js",
    "lib/upstream.d.ts",
    "lib/sse.js",
    "lib/sse.d.ts",
    "lib/usage.js",
    "lib/usage.d.ts",
    "lib/cloud-http.js",
    "lib/cloud-http.d.ts",
    "lib/cloud-search.js",
    "lib/cloud-search.d.ts",
    "lib/cloud-images.js",
    "lib/cloud-images.d.ts",
    "lib/cloud-media.js",
    "lib/cloud-media.d.ts",
    "lib/cloud-vision.js",
    "lib/cloud-vision.d.ts",
    "lib/cloud-tools.js",
    "lib/cloud-tools.d.ts",
    "lib/cloud-context.js",
    "lib/cloud-context.d.ts",
    "lib/cloud-web-tool.js",
    "lib/cloud-web-tool.d.ts",
    "client.js",
    "cordis.patch.yml",
    "assets/readme/hero.svg",
    "assets/readme/workflow.svg",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "CODEX-COMPATIBILITY.md"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepack": "pnpm build"
  },
  "dsh": {
    "engines": {
      "dsh": "0.1.5-rc.1"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-model-selection",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-attachment": "0.1.5-rc.1",
    "@deepseek-ai/dsh-credentials": "0.1.5-rc.1",
    "@deepseek-ai/dsh-fs": "0.1.5-rc.1",
    "@deepseek-ai/dsh-host-webserver": "0.1.5-rc.1",
    "@deepseek-ai/dsh-llm": "0.1.5-rc.1",
    "@deepseek-ai/dsh-sandbox": "0.1.5-rc.1",
    "@deepseek-ai/dsh-sandbox-policy": "0.1.5-rc.1",
    "@deepseek-ai/dsh-shell": "0.1.5-rc.1",
    "@deepseek-ai/dsh-tools": "0.1.5-rc.1"
  },
  "dependencies": {
    "@deepseek-ai/dsh-atomic-write": "0.1.5-rc.1",
    "@deepseek-ai/dsh-home-paths": "0.1.5-rc.1",
    "@deepseek-ai/schemastery": "^3.18.1",
    "https-proxy-agent": "7.0.6",
    "image-size": "^2.0.2",
    "proxy-from-env": "1.1.0",
    "ws": "8.21.3"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-client-ui-model-selection": "0.1.5-rc.1",
    "@deepseek-ai/dsh-web-frontend": "0.1.5-rc.1",
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": "0.1.5-rc.1",
    "@deepseek-ai/dsh-attachment": "0.1.5-rc.1",
    "@deepseek-ai/dsh-attachment-local": "0.1.5-rc.1",
    "@deepseek-ai/dsh-credentials": "0.1.5-rc.1",
    "@deepseek-ai/dsh-fs": "0.1.5-rc.1",
    "@deepseek-ai/dsh-host-webserver": "0.1.5-rc.1",
    "@deepseek-ai/dsh-llm": "0.1.5-rc.1",
    "@deepseek-ai/dsh-sandbox": "0.1.5-rc.1",
    "@deepseek-ai/dsh-sandbox-policy": "0.1.5-rc.1",
    "@deepseek-ai/dsh-scope": "0.1.5-rc.1",
    "@deepseek-ai/dsh-session": "0.1.5-rc.1",
    "@deepseek-ai/dsh-shell": "0.1.5-rc.1",
    "@deepseek-ai/dsh-system-prompt": "0.1.5-rc.1",
    "@deepseek-ai/dsh-tools": "0.1.5-rc.1",
    "@types/node": "^22.20.0",
    "@types/proxy-from-env": "1.0.4",
    "@types/ws": "8.18.1",
    "sharp": "^0.35.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/dsh-attachment": {
      "optional": true
    },
    "@deepseek-ai/dsh-fs": {
      "optional": true
    },
    "@deepseek-ai/dsh-shell": {
      "optional": true
    },
    "@deepseek-ai/dsh-sandbox": {
      "optional": true
    },
    "@deepseek-ai/dsh-sandbox-policy": {
      "optional": true
    }
  }
